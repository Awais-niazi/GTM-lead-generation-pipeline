# Cal.com qualification call (event link + webhook signing secret)
BOOKING_URL=https://cal.com/yourbrand/uk-call
CALCOM_WEBHOOK_SECRET=pick-another-random-string
TIMEZONE=Asia/Karachi

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=1AbC...the-id-from-the-sheet-url
SHEET_TAB=Leads
