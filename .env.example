# Separate spreadsheet shared with the agency (blank = same as GOOGLE_SHEET_ID)
DELIVERY_SHEET_ID=

# Meta app (WhatsApp Cloud API; lead ads are optional)
META_VERIFY_TOKEN=pick-another-random-string
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# You: Hot-lead and call-booked alerts
ALERT_WHATSAPP=+923001112233
# The agency: told when a lead is shipped (optional)
AGENCY_WHATSAPP=

# Update every week or so
GBP_TO_PKR=375

